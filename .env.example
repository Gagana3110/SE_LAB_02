# Copy to .env for local development. Never commit .env.
POSTGRES_USER=dfs
POSTGRES_PASSWORD=change-me-for-local-dev
POSTGRES_DB=dfs

# Long random text that signs login sessions. If empty, users are logged out on every restart.
JWT_SECRET=

# Set to true when the app is served over HTTPS (DFS-SR-001).
COOKIE_SECURE=false

# First Administrator, created at startup if the system has none. Other users are added by them.
ADMIN_EMAIL=admin@dfs-demo.com
ADMIN_PASSWORD=change-me-before-first-run
